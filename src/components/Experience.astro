---
import { profile } from '../data/profile';
---

<section id="experience">
  <div class="section-header reveal">
    <div class="section-number">03</div>
    <h2 class="section-title">Where I've <em>worked.</em></h2>
  </div>
  <div class="exp-list">
    {profile.experience.map((e, i) => (
      <div class="exp-row reveal" style={`transition-delay:${i * 0.08}s`}>
        <div class="exp-timeline">
          <div class="exp-tl-dot" style={e.live ? 'background:rgba(77,184,158,.8);box-shadow:0 0 12px rgba(77,184,158,.3)' : ''}></div>
          {i < profile.experience.length - 1 && <div class="exp-tl-line"></div>}
        </div>
        <div class="exp-content">
          <div class="exp-top-row">
            <div class="exp-meta-left">
              {e.live && <div class="exp-live"><span class="exp-live-dot"></span>Current</div>}
              <div class="exp-date">{e.period}</div>
            </div>
            <div class="exp-badge">{e.badge}</div>
          </div>
          <div class="exp-role" set:html={e.role}></div>
          <div class="exp-co">{e.company}</div>
          <ul class="exp-bullets">
            {e.bullets.map(b => <li set:html={b}></li>)}
          </ul>
          <div class="exp-tags">
            {e.tags.map(t => <span class="exp-tag">{t}</span>)}
          </div>
        </div>
      </div>
    ))}
  </div>
</section>
