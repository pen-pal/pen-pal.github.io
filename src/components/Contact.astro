---
import { profile } from '../data/profile';
---

<section id="contact" style="padding:0;border-bottom:none">
  <div class="contact-grid">
    <div class="contact-left">
      <div class="section-label reveal">Get in touch</div>
      <h2 class="c-heading reveal">Let's<br><em>build.</em></h2>
      <p class="c-sub reveal" style="transition-delay:.1s">Whether it's a migration, a greenfield architecture, or a compliance sprint — I'd love to hear about it.</p>
    </div>
    <div class="contact-right">
      {profile.contact.map((c, i) => (
        <a href={c.href} target={c.href.startsWith('http') ? '_blank' : undefined} class="c-link reveal" style={`transition-delay:${i * 0.04}s`}>
          <div class="c-icon">
            {c.label === 'Email' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="M22 4L12 13 2 4"/></svg>
            )}
            {c.label === 'Phone' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M22 16.92v3a2 2 0 01-2.18 2 19.79 19.79 0 01-8.63-3.07 19.5 19.5 0 01-6-6A19.79 19.79 0 012.12 4.18 2 2 0 014.11 2h3a2 2 0 012 1.72c.127.96.361 1.903.7 2.81a2 2 0 01-.45 2.11L8.09 9.91a16 16 0 006 6l1.27-1.27a2 2 0 012.11-.45c.907.339 1.85.573 2.81.7A2 2 0 0122 16.92z"/></svg>
            )}
	    {c.label === 'LinkedIn' && <svg viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 01-2.063-2.065 2.064 2.064 0 112.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
	    }
	    {c.label === 'GitHub' && <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M9 19c-5 1.5-5-2.5-7-3m14 6v-3.87a3.37 3.37 0 00-.94-2.61c3.14-.35 6.44-1.54 6.44-7A5.44 5.44 0 0020 4.77 5.07 5.07 0 0019.91 1S18.73.65 16 2.48a13.38 13.38 0 01-8 0C5.27.65 4.09 1 4.09 1A5.07 5.07 0 004 4.77a5.44 5.44 0 00-1.5 3.78c0 5.42 3.3 6.61 6.44 7A3.37 3.37 0 008 18.13V22"/></svg>
	    }
            {c.label === 'Medium' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><path d="M4 4h16v16H4z"/><path d="M7 8v8l3-4 3 4V8"/><path d="M17 8l-2 8"/></svg>
            )}
            {c.label === 'Website' && (
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5"><circle cx="12" cy="12" r="10"/><path d="M2 12h20"/><path d="M12 2a15.3 15.3 0 014 10 15.3 15.3 0 01-4 10 15.3 15.3 0 01-4-10 15.3 15.3 0 014-10z"/></svg>
            )}
          </div>
          <div class="c-info">
            <div class="c-label">{c.label}</div>
            <div class="c-val">{c.val}</div>
          </div>
          <span class="c-arrow">↗</span>
        </a>
      ))}
    </div>
  </div>
</section>
