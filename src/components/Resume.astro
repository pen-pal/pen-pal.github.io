---
import { profile } from '../data/profile';
---

<section id="resume">
  <div class="section-header reveal">
    <div class="section-number">06</div>
    <h2 class="section-title">Full <em>CV.</em></h2>
  </div>
  <div class="resume-simple reveal">
    <p class="resume-desc">Full work history, certifications, education, and detailed project breakdowns — all in one document.</p>
    <div class="resume-actions">
      <a href="/manish-khadka-cv.pdf" download class="btn-filled">Download CV</a>
      <a href={profile.linkedin} target="_blank" class="btn-outline">LinkedIn ↗</a>
    </div>
  </div>
</section>
